#!/bin/sh
# Report this agent's token usage to the Agent Index, every 5 minutes.
#
# Carried from plow-pbc/life-assistant-hermes-agent unchanged in behaviour.
# No switch: an install whose owner does not want usage on the index is one
# built without this service.

PATH=/command:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin
export PATH

# Written by first boot from the credential the host dropped in, 0600 root --
# read here, before dropping to the agent's uid. AGENT_ID is which agent this
# is (compose.yml sets it); without it there is nothing to report FOR.
PLOW_AGENT_TOKEN=$(cat /run/s6/container_environment/PLOW_AGENT_TOKEN 2>/dev/null || true)
AGENT_ID=$(cat /run/s6/container_environment/AGENT_ID 2>/dev/null || true)
export AGENT_ID

HERMES_HOME=/var/lib/hermes
export HERMES_HOME

if [ -z "$AGENT_ID" ]; then
  echo "agent-index: no AGENT_ID in this container's environment, so there is no" >&2
  echo "agent to report for -- standing down. Set it in compose.yml." >&2
  exec sleep 86400
fi

while :; do
  # 0 registered · 3 not registered · 2 state present but unreadable.
  # 2 is not 3: registering over unreadable state mints a new install id and
  # strands the usage already published. That pass is skipped instead.
  /command/s6-setuidgid hermes \
    env HOME="$HERMES_HOME" HERMES_HOME="$HERMES_HOME" \
    /opt/hermes/.venv/bin/python3 /opt/plow/agent-index-client.py status >/dev/null
  case $? in
    0) ;;
    3)
      /command/s6-setuidgid hermes \
        env HOME="$HERMES_HOME" HERMES_HOME="$HERMES_HOME" AGENT_ID="$AGENT_ID" PLOW_AGENT_TOKEN="$PLOW_AGENT_TOKEN" \
        /opt/hermes/.venv/bin/python3 /opt/plow/agent-index-client.py \
        --register --agent "$AGENT_ID" >/dev/null || {
      echo "agent-index: no index key this pass, not reporting" >&2
      /bin/sleep 300
      continue
      }
      ;;
    *)
      echo "agent-index: the client could not read this install's state (above);" >&2
      echo "standing off rather than registering over it." >&2
      /bin/sleep 300
      continue
      ;;
  esac

  # Never fatal: a crashing longrun would be respawned in a tight loop.
  /command/s6-setuidgid hermes \
    env HOME="$HERMES_HOME" HERMES_HOME="$HERMES_HOME" AGENT_ID="$AGENT_ID" \
    /opt/hermes/.venv/bin/python3 /opt/plow/agent-index-client.py \
    || echo "agent-index: reporter exited non-zero, see the line above" >&2
  /bin/sleep 300
done
